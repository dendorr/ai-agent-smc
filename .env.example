# AI Agent SMC example environment
# Copy this file to .env and adjust values for your machine.
#
#   cp .env.example .env
#   source .env

# Project paths
# By default, config.py uses the repository root as AI_AGENT_BASE_DIR.
# Set this only if you want data/chroma/memory outside the repo.
# AI_AGENT_BASE_DIR=/home/your-user/ai-agent-smc
# COMPANY_DATA_DIR=/home/your-user/ai-agent-smc/data
# FINANCIAL_DATA_DIR=/home/your-user/ai-agent-smc/data/financial
# DRAWINGS_DATA_DIR=/home/your-user/ai-agent-smc/data/drawings
# DOCUMENTS_DATA_DIR=/home/your-user/ai-agent-smc/data/documents

# LLM backend
# Ollama development default:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama-no-key

# Models
LLM_MODEL_MAIN=qwen2.5:7b
LLM_MODEL_FAST=qwen3:0.6b
EMBED_MODEL=bge-m3
# EMBED_BASE_URL=http://localhost:11434
# EMBED_TIMEOUT_SECONDS=120

# Server
# Bind address for the agent API. Default 127.0.0.1 keeps it off the network.
# Use 0.0.0.0 only behind a firewall and together with AGENT_API_KEY.
# Open WebUI runs in Docker Desktop: set its connection URL to http://host.docker.internal:8000/v1 (not the WSL IP).
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
KIWIX_PORT=8080

# API key for the agent server.
# When set, all /v1/* requests must include: Authorization: Bearer <key>
# Leave empty to disable authentication (local development default).
# AGENT_API_KEY=change-me-in-production

# Allowed CORS origins, comma-separated.
# Leave unset to disable CORS: Open WebUI calls the agent from its backend.
# Set only for browser clients:
# CORS_ORIGINS=http://localhost:3000,https://webui.internal

# Chunking
CHUNK_SIZE=300
CHUNK_OVERLAP=30

# OCR
OCR_ENABLED=false
OCR_MODEL=glm-ocr
OCR_MIN_TEXT_LEN=15
OCR_PDF_PAGE_RASTER_DPI=200
OCR_PDF_MIN_TEXT_PER_PAGE=50
OCR_TIMEOUT_SECONDS=60

# Multi-step retrieval
MULTI_STEP_ENABLED=true
MULTI_STEP_MAX_ROUNDS=1
MULTI_STEP_MIN_CONTEXT_LEN=100

# Timeouts
LLM_TIMEOUT_SECONDS=180
LLM_ROUTING_TIMEOUT_SECONDS=30